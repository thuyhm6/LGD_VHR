<?xml version="1.0" encoding="UTF-8"?>
<ehcache xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="ehcache.xsd" updateCheck="true"
  monitoring="autodetect" dynamicConfig="true" maxBytesLocalHeap="85M">
  
  	<diskStore path="java.io.tmpdir" />
	
  	<defaultCache eternal="false" diskSpoolBufferSizeMB="2"
    	timeToIdleSeconds="120" timeToLiveSeconds="120"
	    diskExpiryThreadIntervalSeconds="120" memoryStoreEvictionPolicy="LRU">
  	</defaultCache>
  
  	<cache name="menuCache" diskSpoolBufferSizeMB="20"
	    timeToIdleSeconds="0" timeToLiveSeconds="0" memoryStoreEvictionPolicy="LRU">
  	</cache>
  	
  	<cache name="debugCache" diskSpoolBufferSizeMB="3"
	    timeToIdleSeconds="0" timeToLiveSeconds="0" memoryStoreEvictionPolicy="LRU">
  	</cache>
  
	<cache name="serviceCache" diskSpoolBufferSizeMB="15"
	    timeToIdleSeconds="0" timeToLiveSeconds="0" memoryStoreEvictionPolicy="LRU">
  	</cache>
  	
  	<cache name="profileCacheSite" diskSpoolBufferSizeMB="5"
    	timeToIdleSeconds="0" timeToLiveSeconds="0" memoryStoreEvictionPolicy="LRU">
  	</cache>
  	
  	<cache name="profileCacheSystem" diskSpoolBufferSizeMB="5"
    	timeToIdleSeconds="0" timeToLiveSeconds="0" memoryStoreEvictionPolicy="LRU">
  	</cache>
  	
  	<cache name="profileCacheUser" diskSpoolBufferSizeMB="5"
    	timeToIdleSeconds="0" timeToLiveSeconds="0" memoryStoreEvictionPolicy="LRU">
  	</cache>


</ehcache>