<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="LGUTLC00407">
	<!-- Role 목록 조회 -->
	<select id="retrieveSystemContactUserList" parameterType="java.util.HashMap" resultType="LGCOMData">
		SELECT *
		FROM lgcom_system_contact_user_v a
		WHERE 1=1
	<if test="systemCode != null and systemCode != ''">
		AND a.system_code = #{systemCode}
	</if>
	<if test="moduleCode != null and moduleCode != ''">
		AND a.module_code = #{moduleCode}
	</if>
		ORDER  BY a.system_code,a.module_code
	</select> 
	
</mapper>
